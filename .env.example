# =============================================================================
# CineMetrics AI - Environment Variables
# =============================================================================
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el archivo .env a git (está en .gitignore).

# -----------------------------------------------------------------------------
# GOOGLE AI (OBLIGATORIO)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# Regla del hackathon: SOLO se permite Google AI (Gemini). Prohibido OpenAI/Anthropic.
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# Modelo de Gemini a usar. Modelos recomendados:
#   - gemini-3.5-flash       → Rápido, económico y con soporte completo para Function Calling (por defecto)
#   - gemini-3.1-flash-lite  → Alternativa ligera y ultra-rápida
#   IMPORTANTE: NO usar el prefijo "models/" (el SDK lo añade internamente)
GEMINI_MODEL=gemini-3.5-flash


# -----------------------------------------------------------------------------
# CLICKHOUSE (OBLIGATORIO para MCP)
# El servidor MCP de ClickHouse (mcp-clickhouse) necesita estas variables
# para conectarse a tu instancia de ClickHouse.
# Docs: https://github.com/ClickHouse/mcp-clickhouse
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DATABASE=cinemetrics

# Si usas ClickHouse Cloud, reemplaza HOST por tu endpoint .clickhouse.cloud
# y pon el puerto 8443 con USE_SSL=true
CLICKHOUSE_USE_SSL=false

# -----------------------------------------------------------------------------
# MCP SERVER (Configuración del proceso del servidor MCP)
# El servidor MCP de ClickHouse se lanza como un subproceso local.
# Asegúrate de tener instalado `uvx` (uv tool runner) o `npx`.
# Comando: uvx mcp-clickhouse  (ver README para instrucciones de instalación)
# -----------------------------------------------------------------------------
MCP_SERVER_COMMAND=uvx
MCP_SERVER_ARGS=mcp-clickhouse

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------
APP_TITLE=CineMetrics AI
APP_ENV=development
LOG_LEVEL=INFO
